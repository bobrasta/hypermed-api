[Unit]
Description=Hypermed API queue worker
After=network.target redis-server.service postgresql.service

[Service]
User=apihy7135
Group=apihy7135
WorkingDirectory=/home/api.hypermed.co.tz/app/current
ExecStart=/usr/local/lsws/lsphp84/bin/php /home/api.hypermed.co.tz/app/current/artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
